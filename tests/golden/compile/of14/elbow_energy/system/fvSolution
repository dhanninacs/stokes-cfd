FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-07;
        relTol          0.1;
    }
    ph_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-07;
        relTol          0.1;
    }
    "(U|e)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-07;
        relTol          0.1;
    }
}

PIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors 1;
    hydrostaticInitialisation yes;
    nHydrostaticCorrectors 5;
    residualControl
    {
        p_rgh           1e-05;
        U               1e-05;
        e               1e-05;
    }
}

relaxationFactors
{
    fields
    {
        p_rgh           0.3;
    }
    equations
    {
        U               0.7;
        e               0.7;
        ".*"            0.7;
    }
}
