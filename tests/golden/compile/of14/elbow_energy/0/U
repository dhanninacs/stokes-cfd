FoamFile
{
    format          ascii;
    class           volVectorField;
    location        "0";
    object          U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    cold_inlet
    {
        type            fixedValue;
        value           uniform (0.1 0.0 0.0);
    }
    hot_inlet
    {
        type            fixedValue;
        value           uniform (0.0 0.3 0.0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0.0 0.0 0.0);
    }
    walls
    {
        type            noSlip;
    }
}
