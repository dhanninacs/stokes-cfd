{
    format          ascii;
    class           volScalarField;
    location        "0";
    object          p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325.0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            uniformFixedValue;
        uniformValue
        {
            type            square;
            amplitude       250.0;
            frequency       50.0;
            start           0.0;
            level           101575.0;
            markSpace       0.333333333333;
        }
        value           uniform 101825.0;
    }
    walls
    {
        type            zeroGradient;
    }
}
