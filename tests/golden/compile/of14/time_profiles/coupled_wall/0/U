FoamFile
{
    format          ascii;
    class           volVectorField;
    location        "0";
    object          U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            uniformFixedValue;
        uniformValue
        {
            type            scale;
            scale
            {
                type            sine;
                amplitude       0.5;
                frequency       4.0;
                start           -0.0625;
                level           2.0;
            }
            value           (0.0 0.0 1.0);
        }
        value           uniform (0.0 0.0 2.5);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0.0 0.0 0.0);
    }
    fluid_to_wall
    {
        type            noSlip;
    }
}
